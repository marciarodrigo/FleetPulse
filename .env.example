# FleetPulse Environment Configuration

# MongoDB Atlas Connection String (Required for Vercel / Cloud deployment)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fleetpulse?retryWrites=true&w=majority

# Optional: Frontend URL for CORS if hosted separately
FRONTEND_URL=https://your-fleetpulse.vercel.app

# Optional: API base URL override for client (defaults to /api on Vercel)
VITE_API_URL=/api
